import numpy as np
import tensorflow as tf
from tensorflow.keras import layers, models
# Example imports for testing different datasets:
from tensorflow.keras.datasets import cifar10, fashion_mnist, mnist 

# --------------------------------------------------
# 1. Define the Residual Block
# --------------------------------------------------
def residual_block(x, filters):
    shortcut = x

    # First convolution
    x = layers.Conv2D(filters, 3, padding="same")(x)
    x = layers.BatchNormalization()(x)
    x = layers.ReLU()(x)

    # Second convolution
    x = layers.Conv2D(filters, 3, padding="same")(x)
    x = layers.BatchNormalization()(x)

    # Match dimensions if required
    if shortcut.shape[-1] != filters:
        shortcut = layers.Conv2D(filters, 1, padding="same")(shortcut)

    # Skip connection
    x = layers.Add()([x, shortcut])
    x = layers.ReLU()(x)

    return x


# --------------------------------------------------
# 2. Dynamic Model Builder Function
# --------------------------------------------------
def build_dynamic_resnet(input_shape, num_classes):
    """
    Builds a ResNet tailored to the provided input shape and number of target classes.
    """
    inputs = layers.Input(shape=input_shape)

    x = layers.Conv2D(32, 3, padding="same", activation="relu")(inputs)

    # Core Residual blocks
    x = residual_block(x, 32)
    x = residual_block(x, 32)
    x = residual_block(x, 64)

    x = layers.GlobalAveragePooling2D()(x)

    # Dynamic output layer
    outputs = layers.Dense(num_classes, activation="softmax")(x)

    model = models.Model(inputs, outputs)
    return model


# --------------------------------------------------
# 3. Load and Auto-Prepare Your Dataset
# --------------------------------------------------
# SWITCH DATASETS HERE TO TEST: try 'cifar10', 'fashion_mnist', or 'mnist'
CHOSEN_DATASET = "fashion_mnist"  

if CHOSEN_DATASET == "cifar10":
    (x_train, y_train), (x_test, y_test) = cifar10.load_data()
elif CHOSEN_DATASET == "fashion_mnist":
    (x_train, y_train), (x_test, y_test) = fashion_mnist.load_data()
else:
    (x_train, y_train), (x_test, y_test) = mnist.load_data()


# Auto-normalize pixel values
x_train = x_train.astype("float32") / 255.0
x_test = x_test.astype("float32") / 255.0

# Auto-add channel dimension if the dataset is grayscale (2D images)
if len(x_train.shape) == 3:
    x_train = x_train[..., None]
    x_test = x_test[..., None]

# Automatically extract structural parameters from the data
input_shape = x_train.shape[1:]             # Extracts (height, width, channels)
num_classes = len(np.unique(y_train))       # Extracts total number of classes

print(f"--- Dataset Loaded: {CHOSEN_DATASET.upper()} ---")
print(f"Detected Input Shape: {input_shape}")
print(f"Detected Target Classes: {num_classes}\n")


# --------------------------------------------------
# 4. Build, Compile, and Train
# --------------------------------------------------
# Generate the tailor-made architecture
model = build_dynamic_resnet(input_shape, num_classes)

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

model.summary()

# Train
model.fit(
    x_train,
    y_train,
    epochs=5,
    batch_size=128,
    validation_split=0.1
)

# Evaluate
test_loss, test_accuracy = model.evaluate(x_test, y_test, verbose=0)
print(f"\n[{CHOSEN_DATASET.upper()}] Final Test Accuracy: {test_accuracy:.4f}")
